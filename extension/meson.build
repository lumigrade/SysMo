# The "SysMo Gauges" GNOME Shell extension. Installed per user; enable it with
#   gnome-extensions enable sysmo-gauges@sysmo.org
# (a Shell restart, Alt+F2 then "r" on X11, or a re-login is needed once).
install_subdir('sysmo-gauges@sysmo.org',
  install_dir: home / '.local' / 'share' / 'gnome-shell' / 'extensions',
)
